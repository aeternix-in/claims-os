# Copy to .env and adjust. All variables are optional.
NHCX_MOCK_DATABASE_URL=sqlite:///./nhcx_mock.db
# Where callbacks (on_submit, paymentnotice/request, ...) are POSTed.
# Default = the mock's own built-in receiver. Point at Aeternix when it has endpoints.
NHCX_MOCK_CALLBACK_BASE_URL=http://127.0.0.1:8000/receiver
NHCX_MOCK_CALLBACK_DELAY_SECONDS=2
NHCX_MOCK_CALLBACK_MAX_ATTEMPTS=3
# approve | partial | reject | query | timeout | callback_fail
NHCX_MOCK_DEFAULT_SCENARIO=approve
NHCX_MOCK_LOG_LEVEL=INFO
# Require NHCX meta.profile URLs on the request Bundle and Claim (true/false)
NHCX_MOCK_STRICT_PROFILES=true
