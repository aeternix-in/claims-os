AETERNIX_DATABASE_URL=sqlite:///./aeternix.db
AETERNIX_NHCX_BASE_URL=http://127.0.0.1:8000
AETERNIX_NHCX_TOKEN=aeternix-dev
AETERNIX_LOG_LEVEL=INFO
AETERNIX_ENVELOPE_MODE=plain
AETERNIX_KEYS_DIR=../dev-keys

# --- Real NHCX sandbox (keep the real values ONLY in your local .env, never in Git/chat) ---
# AETERNIX_AUTH_MODE=session          # static = the local mock token
# AETERNIX_KEY_SOURCE=nhcx            # files = ../dev-keys; nhcx = Fetch Certs from the registry
# AETERNIX_SANDBOX_CLIENT_ID=
# AETERNIX_SANDBOX_CLIENT_SECRET=
# AETERNIX_NHCX_BASE_URL=https://apisbx.abdm.gov.in/hcx

# --- ABDM Milestone 1 (ABHA desk at /ui/abha) ---
# Uses the same SANDBOX_CLIENT_ID / _SECRET as above (gateway session token).
# AETERNIX_ABHA_BASE_URL=https://abhasbx.abdm.gov.in/abha/api
# AETERNIX_ABDM_GATEWAY_URL=https://dev.abdm.gov.in
# Scan & Share: your facility's HIP ID once it is registered and linked to the bridge
# AETERNIX_HIP_ID=
# AETERNIX_COUNTER_ID=REG-DESK-1
