SUPABASE_URL=https://YOUR-REF.supabase.co
# Supabase dashboard -> Connect -> Session pooler (port 5432)
DATABASE_URL=postgresql://postgres.YOUR-REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Only if your project still uses the legacy JWT secret; leave empty for new projects (JWKS)
SUPABASE_JWT_SECRET=
CORS_ORIGINS=http://localhost:5173,https://app.aeternix.in
# Server only, never in web/. Enables Supabase Storage for documents; without it files go to ./.storage
SUPABASE_SERVICE_ROLE_KEY=
# ---- NHCX (protocol settings are aeternix-core's, prefix AETERNIX_) ----
NHCX_ENABLED=false
AETERNIX_NHCX_BASE_URL=http://127.0.0.1:8000        # nhcx-mock locally; sandbox: https://apisbx.abdm.gov.in
AETERNIX_ENVELOPE_MODE=plain                         # jwe for the sandbox format
AETERNIX_KEYS_DIR=../dev-keys                        # <participant_code>.private.pem / .public.pem
AETERNIX_AUTH_MODE=static                            # session = ABDM sandbox login
AETERNIX_KEY_SOURCE=files                            # nhcx = Fetch Certs API
AETERNIX_SANDBOX_CLIENT_ID=
AETERNIX_SANDBOX_CLIENT_SECRET=
AETERNIX_DEMO_MODE=false                             # true only against nhcx-mock
